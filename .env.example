# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-api-key-here

# Optional. Default model. gemini-flash-latest is cheap and fast; gemini-4-argon is the
# high-accuracy choice for fine detail and spatial reasoning.
GEMINI_MODEL=gemini-flash-latest

# Optional defaults for calls that don't pass thinking / media_resolution. Unset = model default.
# GEMINI_THINKING=high            # minimal | low | medium | high (supported levels vary by model)
# GEMINI_MEDIA_RESOLUTION=high    # low | medium | high

# Optional. Append a token-usage line to each answer.
# GEMINI_REPORT_USAGE=1
